# walakelmeh.com on Namecheap (Apache). Deployed with the site by .github/workflows/deploy.yml.

Options -Indexes
DirectoryIndex index.html index.php
AddDefaultCharset utf-8
AddType application/manifest+json .webmanifest
AddType text/plain .txt

RewriteEngine On

# One address: https, no www.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://walakelmeh.com%{REQUEST_URI} [R=301,L]

# Old address of the privacy page.
RewriteRule ^privacy\.html$ /privacy/ [R=301,L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"

  # Pages and the game's service worker must always be fresh; hashed files can be cached for a year.
  <FilesMatch "\.(html|webmanifest|txt|xml)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "^(sw\.js|registerSW\.js)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|webp|svg|jpg|ico|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json application/manifest+json image/svg+xml
</IfModule>
